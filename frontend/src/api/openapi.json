{
  "openapi": "3.1.0",
  "info": {
    "title": "Voting ideas",
    "description": "Build a small Idea Voting Board with sign up. Features 1. Sign up with email and password. Log in and log out. 2. Post an idea (title, short description). Logged-in users only. 3. List ideas by votes, highest first. Anyone can view. 4. Upvote an idea. One vote per user per idea.",
    "version": "0.1.0"
  },
  "paths": {
    "/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register",
        "operationId": "register_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponse"
                }
              }
            }
          },
          "409": {
            "description": "This email is already registered."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login",
        "description": "Verifies the credentials and starts a session (AC-010); a wrong password or an\nunknown email is refused the same generic way, and no session is started\n(AC-011, NFR-005).",
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Incorrect email or password."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Me",
        "description": "The signed-in user for a still-active session token (AC-012, NFR-002).",
        "operationId": "me_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            }
          },
          "401": {
            "description": "Your session has expired. Please log in again."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Logout",
        "description": "Revokes the current session token server-side (AC-013, NFR-003), confirming it\nin the 200 response the case calls for (TC-001, TC-002): the session is gone, not\nmerely acknowledged with no body.",
        "operationId": "logout_auth_logout_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Logout Auth Logout Post"
                }
              }
            }
          },
          "401": {
            "description": "Your session has expired. Please log in again."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/ideas": {
      "get": {
        "tags": [
          "Ideas"
        ],
        "summary": "List Ideas",
        "operationId": "list_ideas_ideas_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/IdeaRead"
                  },
                  "type": "array",
                  "title": "Response List Ideas Ideas Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Ideas"
        ],
        "summary": "Create Idea",
        "description": "Creates the idea attributed to the signed-in caller, starting at zero upvotes\n(AC-014). An empty title or description, or one over the length limit, never\nreaches here: IdeaCreate's own validation refuses it first, as a 422 (AC-015). A\ncaller with no valid session is refused the same SESSION_EXPIRED way as any other\naction that needs login, and no idea is created (AC-016).",
        "operationId": "create_idea_ideas_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IdeaCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdeaRead"
                }
              }
            }
          },
          "401": {
            "description": "Your session has expired. Please log in again."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/ideas/{id}": {
      "patch": {
        "tags": [
          "Ideas"
        ],
        "summary": "Update Idea",
        "description": "Updates the title and description of an idea the signed-in caller authored\n(AC-017). An empty title or description, or one over the length limit, never\nreaches here: IdeaUpdate's own validation refuses it first, as a 422, leaving the\noriginal idea unchanged (AC-019). A caller who is signed in but did not author this\nidea is refused as IDEA_NOT_AUTHOR, and the idea is left unchanged (AC-018,\nNFR-006). An id that matches no idea is refused as IDEA_NOT_FOUND.",
        "operationId": "update_idea_ideas__id__patch",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IdeaUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdeaRead"
                }
              }
            }
          },
          "401": {
            "description": "Your session has expired. Please log in again."
          },
          "403": {
            "description": "Only the author can edit this idea."
          },
          "404": {
            "description": "Idea not found."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "description": "Liveness probe, and the only route here that is not a stub.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CurrentUser": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "role": {
            "type": "string",
            "title": "Role"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "role"
        ],
        "title": "CurrentUser",
        "description": "GET /auth/me reply: the signed-in user for a still-valid session token."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IdeaCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "title",
          "description"
        ],
        "title": "IdeaCreate",
        "description": "POST /ideas body: a new idea's title and short description (US-006).\n\nBoth fields must be non-empty and within the allowed length (AC-014); an empty\ntitle or description, or one over the limit, is rejected here, by FastAPI's own\n422 validation response, before any handler runs (AC-015). The author is never\nread from this body: it is always the signed-in caller (app/auth.py's `current_user`)."
      },
      "IdeaRead": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "upvoteCount": {
            "type": "integer",
            "title": "Upvotecount"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "upvoteCount"
        ],
        "title": "IdeaRead",
        "description": "One idea as shown on the public board (US-001)."
      },
      "IdeaUpdate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "title",
          "description"
        ],
        "title": "IdeaUpdate",
        "description": "PATCH /ideas/{id} body: the author's edited title and description (US-007).\n\nSame bounds as IdeaCreate (AC-019): an empty title or description, or one over the\nallowed length, is rejected here, by FastAPI's own 422 validation response, before\nany handler runs, and the original idea is left unchanged. Whether the caller may\nedit this idea at all -- only its author may (AC-018, NFR-006) -- is checked in the\nhandler, never here: it depends on the signed-in caller and the idea in the\ndatabase, neither of which this model has."
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "description": "POST /auth/login body: the email and password for an existing account (AC-010).\n\nBoth fields stay plain strings, not a stricter type: an unknown or malformed email\nmust fail the same generic way as a wrong password (AC-011, NFR-005), never as a\ndistinct validation error that names the email as the problem."
      },
      "LoginResponse": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          }
        },
        "type": "object",
        "required": [
          "token"
        ],
        "title": "LoginResponse",
        "description": "POST /auth/login reply: the opaque session token (AC-010); never a password or hash."
      },
      "RegisterRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "RegisterRequest",
        "description": "POST /auth/register body: the email and password a visitor chooses (AC-006).\n\nA malformed email or a password shorter than the stated rules is rejected here,\nby FastAPI's own 422 validation response, before any handler runs (AC-008)."
      },
      "RegisterResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email"
        ],
        "title": "RegisterResponse",
        "description": "The account POST /auth/register created; never the password or its hash."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
